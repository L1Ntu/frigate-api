{
  "name": "l1ntu/frigate-api",
  "description": "PHP client for the Frigate NVR HTTP API",
  "type": "library",
  "keywords": ["frigate", "nvr", "api", "client", "psr-18"],
  "license": "MIT",
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "Ihor Chaban",
      "email": "lintuh@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.0 || ^2.0"
  },
  "require-dev": {
    "guzzlehttp/psr7": "^2.6",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "L1Ntu\\Frigate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "L1Ntu\\Frigate\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
